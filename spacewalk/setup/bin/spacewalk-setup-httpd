import sys
import os
import glob
import shutil
import argparse
import subprocess
import time
import re

SHARED_DIR = "/usr/share/spacewalk/setup"
SSL_CONF_DIR = "/etc/apache2/vhosts.d"
SSL_CONF = "vhost-ssl.conf"
NOS_CONF = "vhost-nossl.conf"


def os_fips_mode_on():
    if not os.path.exists("/proc/sys/crypto/fips_enabled"):
        return False
    try:
        sysctl_bin = (
            "/usr/sbin/sysctl" if os.path.exists("/usr/sbin/sysctl") else "/sbin/sysctl"
        )
        ret = (
            subprocess.check_output([sysctl_bin, "-n", "crypto.fips_enabled"])
            .decode("utf-8")
            .strip()
        )
        return ret == "1"
    except Exception:
        return False


def mod_ssl_fipsmode_option():
    try:
        ret = (
            subprocess.check_output(
                ["rpm", "-q", "--qf", "%{VERSION}", "apache2-prefork"]
            )
            .decode("utf-8")
            .strip()
        )
        # Parse version to ensure it is > 2.4.0
        parts = [int(x) for x in re.findall(r"\d+", ret)]
        if parts and parts[0] >= 2 and parts[1] >= 4:
            return True
    except Exception:
        pass
    return False


def modify_conf_content(conf_content, conf_files):
    for path in sorted(glob.glob(os.path.join(SHARED_DIR, conf_files + ".*"))):
        try:
            with open(path, "r", encoding="utf-8") as f:
                regexp = f.readline().strip("\r\n")
                content = f.read()
            if re.search(regexp, conf_content, re.MULTILINE):
                conf_content = re.sub(regexp, content, conf_content, flags=re.MULTILINE)
            else:
                if conf_content and not conf_content.endswith("\n"):
                    conf_content += "\n"
                conf_content += content
        except Exception as e:
            sys.stderr.write(f"Error modifying with {path}: {e}\n")
    return conf_content


def setup_mod_nossl():
    nossl_path = os.path.join(SSL_CONF_DIR, NOS_CONF)
    if not os.path.exists(nossl_path):
        source = os.path.join(SHARED_DIR, NOS_CONF)
        if os.path.exists(source):
            shutil.copy(source, nossl_path)
        else:
            sys.stderr.write(f"Source configuration {source} not found.\n")


def setup_mod_ssl(fips_mode_on):
    ssl_path = os.path.join(SSL_CONF_DIR, SSL_CONF)
    if not os.path.exists(ssl_path):
        template = os.path.join(SSL_CONF_DIR, "vhost-ssl.template")
        if os.path.exists(template):
            shutil.copy(template, ssl_path)

    if not os.path.exists(ssl_path):
        sys.stderr.write(f"{ssl_path} does not exist.\n")
        sys.exit(1)

    with open(ssl_path, "r", encoding="utf-8", errors="ignore") as f:
        ssl_content = f.read()

    match = re.search(
        r"(.*<VirtualHost _default_:443>)(.*)(</VirtualHost>.*)", ssl_content, re.DOTALL
    )
    if not match:
        sys.stderr.write(
            "Setup was unable to locate VirtualHost section in existing mod_ssl configuration.\n"
        )
        sys.exit(1)

    pre, vhost, post = match.groups()
    vhost_modified = modify_conf_content(vhost, "mod_ssl.conf.vhost")

    if (fips_mode_on or os_fips_mode_on()) and mod_ssl_fipsmode_option():
        post = modify_conf_content(post, "mod_ssl.conf.sslfips")

    new_content = pre + vhost_modified + post
    if new_content != ssl_content:
        # Backup original
        backup_path = f"{ssl_path}.backup-{int(time.time())}"
        shutil.copy(ssl_path, backup_path)

        with open(ssl_path, "w", encoding="utf-8") as f:
            f.write(new_content)
        os.chmod(ssl_path, 0o644)


def main():
    parser = argparse.ArgumentParser(
        description="Configure Apache HTTPD for Uyuni/SUSE Manager."
    )
    parser.add_argument(
        "--fips-mode-on",
        action="store_true",
        help="Turn SSL FIPS mode on (when applicable)",
    )
    parser.add_argument("--no-ssl", action="store_true", help="Configure without SSL")
    args = parser.parse_args()

    if args.no_ssl:
        setup_mod_nossl()
    else:
        setup_mod_ssl(args.fips_mode_on)


if __name__ == "__main__":
    main()
