# logrotation file for Spacewalk Server package uploader
#

/var/log/rhn/rhn_upload_package_push.log {
    rotate 5
    copytruncate
    compress
    notifempty
    missingok
    size 10M
    su @HTTPD_USER@ @HTTPD_GROUP@
}
