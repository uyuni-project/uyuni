#!/usr/bin/env python3
import sys
import os
import re
import glob
import argparse
import subprocess
import datetime

# PostgreSQL compatibility limits
MIN_PG_DB_VERSION = 140001;
MAX_PG_DB_VERSION = 189999;
MIN_PG_DB_VERSION_STRING = "14";
MAX_PG_DB_VERSION_STRING = "18";

CONFIG_FILE = "/etc/rhn/rhn.conf"

class MainDb:
    DB_NAME = 'postgres'
    UPGRADE_PREFIX = 'schema'
    BACKEND_PROPERTY = 'db_backend'
    
    @staticmethod
    def get_schema_version_query():
        return """
     SELECT pn.name || '-' || (pe.evr).version || '-' || (pe.evr).release
       FROM rhnVersionInfo vi
               INNER JOIN rhnPackageName pn ON vi.name_id = pn.id
               INNER JOIN rhnPackageEVR pe ON vi.evr_id = pe.id
      WHERE vi.label = 'schema';
"""

    @staticmethod
    def get_migration_dir_query():
        return """
     SELECT label
       FROM rhnVersionInfo
      WHERE label LIKE 'schema-from%'
   ORDER BY label DESC;
"""

    @staticmethod
    def update_migration_dir(migration_dir):
        return f"""
     UPDATE rhnVersionInfo
        SET label = '{migration_dir}'
                , modified = current_timestamp
      WHERE label = 'schema';
"""

    @staticmethod
    def insert_version_info(schema_name, schema_version, schema_release):
        return f"""
INSERT INTO rhnVersionInfo( label, name_id, evr_id, created, modified )
     VALUES ('schema'
                , lookup_package_name('{schema_name}')
                , lookup_evr(null, '{schema_version}' , '{schema_release}', 'rpm' )
                , current_timestamp
                , current_timestamp
            );
     COMMIT;
"""


class ReportDb:
    DB_NAME = 'reportdb'
    UPGRADE_PREFIX = 'reportdb-schema'
    BACKEND_PROPERTY = 'report_db_backend'
    
    @staticmethod
    def get_schema_version_query():
        return """
     SELECT name || '-' || version || '-' || release
       FROM versioninfo
      WHERE label = 'schema';
"""

    @staticmethod
    def get_migration_dir_query():
        return """
     SELECT label
       FROM versioninfo
      WHERE label LIKE 'schema-from%'
   ORDER BY label DESC;
"""

    @staticmethod
    def update_migration_dir(migration_dir):
        return f"""
     UPDATE versioninfo
        SET label = '{migration_dir}'
                , modified = current_timestamp
      WHERE label = 'schema';
"""

    @staticmethod
    def insert_version_info(schema_name, schema_version, schema_release):
        return f"""
INSERT INTO versioninfo( label, name, version, release )
     VALUES ('schema'
                , '{schema_name}'
                , '{schema_version}'
                , '{schema_release}'
            );
     COMMIT;
"""


def is_true(val):
    if val is None:
        return False
    return str(val).lower() in ('1', 'y', 'true', 'yes', 'on')


def read_config(config_file):
    options = {}
    try:
        with open(config_file, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#') or '[comment]' in line:
                    continue
                if '=' in line:
                    key, val = line.split('=', 1)
                    options[key.strip()] = val.strip()
    except Exception as e:
        sys.stderr.write(f"Could not open {config_file}: {e}\n")
        sys.exit(1)
    return options


def run_query(command, reportdb=False):
    args = ['spacewalk-sql', '--select-mode']
    if reportdb:
        args.append('--reportdb')
    args.append('-')
    
    env = os.environ.copy()
    env['LANG'] = 'C'
    
    try:
        proc = subprocess.Popen(
            args,
            env=env,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        out_data, _ = proc.communicate(input=command + "\n")
    except Exception:
        return None
        
    if proc.returncode != 0:
        return None
        
    lines = out_data.splitlines()
    out = None
    seen_dashes = False
    for line in lines:
        if seen_dashes:
            out = line
            break
        if '---' in line:
            seen_dashes = True
            
    if out is not None:
        out = out.strip()
        if out == '(0 rows)':
            out = None
    return out


def run_query_direct(msg, file_path, log_file, reportdb=False, default_tablespace=None):
    sql = f"select '{msg}' from dual;\n"
    try:
        with open(file_path, 'r', encoding='utf-8', errors='ignore') as f:
            f_in = f.read()
    except Exception as e:
        sys.stderr.write(f"Cannot open file '{file_path}': {e}\n")
        sys.exit(1)
        
    f_in = re.sub(r'^--.*\n', '', f_in, flags=re.M)
    if default_tablespace:
        f_in = re.sub(r'\[\[.*?\]\]|__.*?__', default_tablespace, f_in)
        
    sql += f_in
    sql += "\ncommit;\n"
    
    log_file.write("SQL> ")
    log_file.write(sql + "\n")
    log_file.flush()
    
    args = ['spacewalk-sql', '--select-mode-direct']
    if reportdb:
        args.append('--reportdb')
    args.append('-')
    
    try:
        proc = subprocess.Popen(
            args,
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        stdout_data, stderr_data = proc.communicate(input=sql + "\n")
    except Exception as e:
        sys.stderr.write(f"Cannot execute spacewalk-sql: {e}\n")
        sys.exit(1)
        
    log_file.write(stdout_data)
    log_file.write(stderr_data)
    log_file.flush()
    
    return proc.returncode


def build_graph(upgrade_dir):
    edges = []
    for f in glob.glob(os.path.join(upgrade_dir, "*-to-*")):
        base = os.path.basename(f)
        if "-to-" in base:
            src, dest = base.rsplit("-to-", 1)
            edges.append((src, dest))
    return edges


def get_bfs_path(start, target, edges):
    from collections import deque
    queue = deque([[start]])
    visited = {start}
    while queue:
        path = queue.popleft()
        node = path[-1]
        if node == target:
            return path[1:]
        for src, dest in edges:
            if src == node and dest not in visited:
                visited.add(dest)
                queue.append(path + [dest])
    return None


def match_overrides(*patterns):
    files = []
    for pat in patterns:
        files.extend(glob.glob(pat))
    files = list(set(files))
    files = [f for f in files if os.path.exists(f)]
    result = []
    for f in files:
        override = f + ".override"
        if os.path.exists(override):
            result.append(override)
        else:
            result.append(f)
    result.sort()
    return result


def rmdir_and_die(msg, directory=None):
    if directory and os.path.isdir(directory):
        for f in os.listdir(directory):
            try:
                os.unlink(os.path.join(directory, f))
            except Exception:
                pass
        try:
            os.rmdir(directory)
        except Exception:
            pass
    sys.stderr.write(msg + "\n")
    sys.exit(1)


def expand_files(fullname, backend, upgrade_dir, migration_log_dir):
    if fullname.endswith('.ref') or fullname.endswith(f'.ref.{backend}'):
        subfiles = []
        try:
            with open(fullname, 'r', encoding='utf-8') as ref_f:
                for line in ref_f:
                    line = line.strip()
                    if not line or line.startswith('#'):
                        continue
                    pat1 = os.path.join(upgrade_dir, line)
                    pat2 = os.path.join(upgrade_dir, f"{line}.{backend}")
                    new_sub = match_overrides(pat1, pat2)
                    if not new_sub:
                        rmdir_and_die(f"Could not find any files matching [{line}] from [{fullname}]", migration_log_dir)
                    for ns in new_sub:
                        subfiles.extend(expand_files(ns, backend, upgrade_dir, migration_log_dir))
        except Exception as e:
            rmdir_and_die(f"Error reading [{fullname}]: {e}\n", migration_log_dir)
        return subfiles
    else:
        return [fullname]


def run_schema_upgrade(directory, logfilename, target_schema, default_tablespace, skip_confirm, db_name, reportdb=False):
    if not os.path.isdir(directory):
        sys.stderr.write(f"Migration directory [{directory}] does not exist.\n")
        sys.exit(1)
        
    print(f"Planning to run schema upgrade with dir '{directory}'")
    if not skip_confirm:
        while True:
            try:
                val = input("Hit Enter to continue or Ctrl+C to interrupt: ")
                if val == '':
                    break
            except KeyboardInterrupt:
                print("\nInterrupted.")
                sys.exit(1)
                
    log_dir = os.path.dirname(directory)
    logfile = os.path.join(log_dir, logfilename)
    
    try:
        log_f = open(logfile, 'a', encoding='utf-8')
    except Exception as e:
        sys.stderr.write(f"Error writing logfile [{logfile}]: {e}\n")
        sys.exit(1)
        
    # Execute restorecon if available
    try:
        subprocess.run(f"restorecon {logfile}", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
        
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_f.write(f"================== started: {now} ==================\n")
    print(f"Executing spacewalk-sql, the log is in [{logfile}].")
    
    migrationfiles = sorted(glob.glob(os.path.join(directory, "*")))
    filecount = len(migrationfiles)
    counter = 0
    
    for migfile in migrationfiles:
        counter += 1
        link = migfile
        if os.path.islink(migfile):
            try:
                link = os.readlink(migfile)
            except Exception:
                pass
        fn = os.path.basename(link)
        td = os.path.basename(os.path.dirname(link))
        
        sys.stdout.write(f"({counter}/{filecount}) apply upgrade [{td}/{fn}]        \r")
        sys.stdout.flush()
        
        ret = run_query_direct(f"{td}/{fn}", migfile, log_f, reportdb=reportdb, default_tablespace=default_tablespace)
        if ret != 0:
            print("\n")
            log_f.close()
            sys.stderr.write(f"Upgrade failed, please see log [{logfile}].\nYou can fix the failed migration in [{directory}]\nand run spacewalk-schema-upgrade again\n")
            sys.exit(1)
        try:
            os.unlink(migfile)
        except Exception:
            pass
            
    print("\n")
    log_f.close()
    
    db_spec = ReportDb if reportdb else MainDb
    new_schema_version = run_query(db_spec.get_schema_version_query(), reportdb=reportdb)
    if not new_schema_version:
        sys.stderr.write("Upgrade seems to have run OK yet new schema version is not in rhnVersionInfo.\n")
        sys.exit(1)
    if new_schema_version != target_schema:
        sys.stderr.write(f"Upgrade seems to have run OK yet new schema version is\n[{new_schema_version}], not [{target_schema}].\nPlease run schema upgrade again.\n")
        sys.exit(1)
        
    try:
        os.rmdir(directory)
    except Exception:
        pass
    print(f"The database schema was upgraded to version [{target_schema}].")


def main():
    parser = argparse.ArgumentParser(description="utility for Spacewalk / Satellite schema upgrade")
    parser.add_argument('-y', '--yes', action='store_true', help="Proceed without asking for confirmation.")
    parser.add_argument('--reportdb', action='store_true', help="Upgrade the local reporting database instead of the application database.")
    args = parser.parse_args()
    
    if not os.path.exists(CONFIG_FILE):
        sys.stderr.write(f"The config file [{CONFIG_FILE}] does not seem to exist. Was Spacewalk configured yet?\n")
        sys.exit(1)
        
    db_specific = ReportDb if args.reportdb else MainDb
    
    SCHEMA_DIR = f"/usr/share/susemanager/db/{db_specific.DB_NAME}"
    SCHEMA_UPGRADE_DIR = f"/usr/share/susemanager/db/{db_specific.UPGRADE_PREFIX}-upgrade"
    SCHEMA_UPGRADE_LOGDIR = f"/var/log/spacewalk/{db_specific.UPGRADE_PREFIX}-upgrade"
    
    options = read_config(CONFIG_FILE)
    if db_specific.BACKEND_PROPERTY not in options:
        sys.stderr.write(f"Config file [{CONFIG_FILE}] does not seem to have database backend info ({db_specific.BACKEND_PROPERTY}) set.\n")
        sys.exit(1)
        
    os.environ['NLS_LANG'] = 'AMERICAN_AMERICA.UTF8'
    os.environ['NLS_NUMERIC_CHARACTERS'] = '.'
    
    test_res = run_query("select '1' || '2' || '3' as testing from dual;", reportdb=args.reportdb)
    if not test_res:
        sys.stderr.write("Connect to database was not successful.\n")
        sys.exit(1)
    if test_res != '123':
        sys.stderr.write("Test select from database did not give expected results.\n")
        sys.exit(1)
        
    default_tablespace = None
    server_version_str = run_query("show server_version_num;", reportdb=args.reportdb)
    pg_version_str = run_query("show server_version;", reportdb=args.reportdb)
    
    server_version = int(server_version_str) if server_version_str else 0
    if server_version < MIN_PG_DB_VERSION:
        sys.stderr.write(f"\nRunning postgresql {pg_version_str} is not supported. Minimal required version is {MIN_PG_DB_VERSION_STRING}.\n\n")
        sys.exit(1)
    elif server_version > MAX_PG_DB_VERSION:
        sys.stderr.write(f"\nRunning postgresql {pg_version_str} is not supported. Maximal allowed version is {MAX_PG_DB_VERSION_STRING}.\n\n")
        sys.exit(1)
        
    # Get local package schema version
    # Since this query runs on the main.sql file, let's use subprocess to run rpm
    rpm_cmd = f"rpm -qf --qf '%{{name}} %{{version}} %{{release}}\\n' {SCHEMA_DIR}/main.sql"
    try:
        rpm_out = subprocess.check_output(rpm_cmd, shell=True, text=True).strip()
    except subprocess.CalledProcessError:
        sys.stderr.write("Failed to retrieve our schema package name and version via RPM.\n")
        sys.exit(1)
        
    m = re.match(r'^(\S+)\s(\S+)\s(\S+)$', rpm_out)
    if not m:
        sys.stderr.write("Failed to parse RPM schema info.\n")
        sys.exit(1)
        
    my_schema_name, my_schema_version, my_schema_release = m.groups()
    
    if os.environ.get('SUMA_TEST_SCHEMA_VERSION'):
        my_schema_version = os.environ['SUMA_TEST_SCHEMA_VERSION']
        
    target_schema = f"{my_schema_name}-{my_schema_version}-{my_schema_release}"
    target_schema_norm = re.sub(r'^(.+-\d+(?:\.\d+)*-[a-zA-Z0-9]*)(?:\..*)*$', r'\1', target_schema)
    
    schema_version = run_query(db_specific.get_schema_version_query(), reportdb=args.reportdb)
    
    if not schema_version:
        migrationdir = run_query(db_specific.get_migration_dir_query(), reportdb=args.reportdb)
        migrationdir_path = os.path.join(SCHEMA_UPGRADE_LOGDIR, migrationdir) if migrationdir else ""
        if not migrationdir or not os.path.isdir(migrationdir_path):
            sys.stderr.write("No existing schema version info found in rhnVersionInfo.\n")
            sys.exit(1)
            
        logfiles = sorted(glob.glob(os.path.join(SCHEMA_UPGRADE_LOGDIR, f"{migrationdir}-to-*.log")), reverse=True)
        lname = os.path.basename(logfiles[0]) if logfiles else f"{migrationdir}.log"
        print("Found unfinished schema migration")
        print("Try to continue schema migration")
        run_schema_upgrade(migrationdir_path, lname, target_schema, default_tablespace, args.yes, db_specific.DB_NAME, reportdb=args.reportdb)
        sys.exit(0)
        
    regex = "^(uyuni|susemanager|spacewalk|satellite|rhn-satellite)-" + db_specific.UPGRADE_PREFIX + "-"
    if not re.search(regex, schema_version):
        sys.stderr.write(f"Unknown schema name [{schema_version}] found.\n")
        sys.exit(1)
        
    start_schema = schema_version
    start_schema_norm = re.sub(r'^(.+-\d+(?:\.\d+)*-[a-zA-Z0-9]*)(?:\..*)*$', r'\1', start_schema)
    
    print(f"Schema upgrade: [{start_schema}] -> [{target_schema}]")
    if start_schema == target_schema:
        print(f"Your database schema already matches the schema package version [{target_schema}].")
        sys.exit(0)
        
    edges = build_graph(SCHEMA_UPGRADE_DIR)
    
    found_target = False
    for src, dest in edges:
        if dest == target_schema_norm:
            found_target = True
            break
            
    if not found_target:
        # Strip dist tag / suffix
        m = re.match(r'^(.+-.+)-[a-zA-Z0-9]+(?:\.\d+)*$', target_schema_norm)
        if m:
            target_schema_norm = m.group(1)
            for src, dest in edges:
                if dest == target_schema_norm:
                    found_target = True
                    break
                    
    if not found_target:
        m = re.match(r'^(.+-.+\..+)\.[^.-]+$', target_schema_norm)
        if m:
            target_schema_norm = m.group(1)
            for src, dest in edges:
                if dest == target_schema_norm:
                    found_target = True
                    break
                    
    if not found_target:
        sys.stderr.write(f"Was not able to find upgrade path in directory [{SCHEMA_UPGRADE_DIR}].\n")
        sys.exit(1)
        
    if start_schema_norm == target_schema_norm:
        print("The schema version is the same, except for the dist tag.")
        path = []
    else:
        all_nodes = set(src for src, dest in edges) | set(dest for src, dest in edges)
        
        if start_schema_norm not in all_nodes:
            m = re.match(r'^(.+-.+)-\d+(?:\.\d+)*$', start_schema_norm)
            if m:
                start_schema_norm = m.group(1)
                
        if start_schema_norm not in all_nodes:
            m = re.match(r'^(.+-.+\..+)\.[^.-]+$', start_schema_norm)
            if m:
                start_schema_norm = m.group(1)
                
        if start_schema_norm not in all_nodes:
            sys.stderr.write(f"Was not able to find upgrade path in directory [{SCHEMA_UPGRADE_DIR}].\n")
            sys.exit(1)
            
        path = get_bfs_path(start_schema_norm, target_schema_norm, edges)
        if path is None:
            sys.stderr.write(f"Was not able to find upgrade path in directory [{SCHEMA_UPGRADE_DIR}].\n")
            sys.exit(1)
            
    print("The path: " + " -> ".join(f"[{x}]" for x in [start_schema_norm] + path))
    
    os.makedirs("/var/log/spacewalk", mode=0o755, exist_ok=True)
    os.makedirs(SCHEMA_UPGRADE_LOGDIR, mode=0o755, exist_ok=True)
    
    try:
        subprocess.run(f"restorecon {SCHEMA_UPGRADE_LOGDIR}", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass
        
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    start = start_schema_norm
    migrationdir = f"schema-from-{stamp}"
    
    # Update migration dir in database
    update_sql = db_specific.update_migration_dir(migrationdir)
    run_q_res = run_query(update_sql, reportdb=args.reportdb)
    
    migrationdir_path = os.path.join(SCHEMA_UPGRADE_LOGDIR, migrationdir)
    os.makedirs(migrationdir_path, mode=0o755, exist_ok=True)
    
    init_sql_path = os.path.join(migrationdir_path, "00_0000-upgrade-start.sql")
    try:
        with open(init_sql_path, 'w', encoding='utf-8') as init_f:
            init_f.write(update_sql + "\n")
    except Exception as e:
        rmdir_and_die(f"Cannot create upgrade-start file: {e}", migrationdir_path)
        
    prenum = 0
    backend = options[db_specific.BACKEND_PROPERTY]
    
    for t in path:
        transition_dir_name = f"{start}-to-{t}"
        transition_dir = os.path.join(SCHEMA_UPGRADE_DIR, transition_dir_name)
        if not os.path.exists(transition_dir):
            rmdir_and_die(f"Directory [{transition_dir}] was seen but is lost now.", migrationdir_path)
            
        if prenum > 98:
            rmdir_and_die("Overrun: too many migrations", migrationdir_path)
            
        files_pat1 = os.path.join(transition_dir, "*.ref")
        files_pat2 = os.path.join(transition_dir, f"*.sql.{backend}")
        files_pat3 = os.path.join(transition_dir, f"*.ref.{backend}")
        
        files = match_overrides(files_pat1, files_pat2, files_pat3)
        expanded = []
        for f in files:
            expanded.extend(expand_files(f, backend, SCHEMA_UPGRADE_DIR, migrationdir_path))
            
        for fullname in expanded:
            name = os.path.basename(fullname)
            linkname = f"{prenum:02d}_{name}"
            link_path = os.path.join(migrationdir_path, linkname)
            try:
                os.symlink(fullname, link_path)
            except Exception as e:
                rmdir_and_die(f"Cannot create symlink {link_path} -> {fullname}: {e}", migrationdir_path)
                
        start = t
        prenum += 1
        
    # Prepare upgrade-end.sql
    endfile = os.path.join(SCHEMA_DIR, "upgrade-end.sql")
    try:
        with open(endfile, 'r', encoding='utf-8') as end_f:
            end_in = end_f.read()
    except Exception as e:
        rmdir_and_die(f"Error reading [{endfile}]: {e}", migrationdir_path)
        
    end_in += db_specific.insert_version_info(my_schema_name, my_schema_version, my_schema_release)
    
    end_sql_path = os.path.join(migrationdir_path, "99_9999-upgrade-end.sql")
    try:
        with open(end_sql_path, 'w', encoding='utf-8') as end_sql_f:
            end_sql_f.write(end_in)
    except Exception as e:
        rmdir_and_die(f"Error writing [{end_sql_path}]: {e}", migrationdir_path)
        
    lname = f"{migrationdir}-to-{start}.log"
    run_schema_upgrade(migrationdir_path, lname, target_schema, default_tablespace, args.yes, db_specific.DB_NAME, reportdb=args.reportdb)


if __name__ == '__main__':
    main()
