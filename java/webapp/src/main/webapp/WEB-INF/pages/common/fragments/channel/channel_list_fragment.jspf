<c:choose>
    <c:when test="${current.channelId == null}">
        <bean:message key="none.message"/>
    </c:when>
    <c:otherwise>
        <c:out value="<a href='/rhn/channels/ChannelDetail.do?cid=${current.channelId}'>${current.channelLabels}</a>" escapeXml="false" />
    </c:otherwise>
</c:choose>
