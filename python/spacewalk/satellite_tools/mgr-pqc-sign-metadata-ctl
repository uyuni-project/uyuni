set -e

PQC_MIN_OPENSSL_VER="3.5.0"
PQC_SIGNATURE_EXTENSION="p7s"
PQC_DEFAULT_KEYS_DIR="/root/.pqkeys"
PQC_DEFAULT_PRIVATE_KEY_FILE="$PQC_DEFAULT_KEYS_DIR/mgr-pqc-priv.pem"
PQC_DEFAULT_PUBLIC_KEY_FILE="$PQC_DEFAULT_KEYS_DIR/mgr-pqc-pub.pem"
PQC_DEFAULT_CERTIFICATE_FILE="$PQC_DEFAULT_KEYS_DIR/mgr-pqc-cert.pem"

RHN_CONF="/etc/rhn/rhn.conf"
PQC_DEFAULT_CERTIFICATE_SUBJECT="/CN=Multi-Linux Manager Custom PQC Key/O=Multi-Linux Manager"
PQC_RHN_CONF_SIGN_ENTRY="sign_pqc_metadata"
PQC_CUSTOM_SIGNATURE_FILENAME="repomd.xml.$PQC_SIGNATURE_EXTENSION"

PQC_SALT_EXPORT_DIR="/srv/susemanager/salt/pqc"
PQC_SALT_EXPORT_CERTIFICATE_FILE="$PQC_SALT_EXPORT_DIR/mgr-pqc-cert.pem"
PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE="$(spacewalk-cfg-get documentroot)/pub/mgr-pqc-cert.pem"

SIGNING_CONF="/etc/rhn/signing.conf"
PQC_SIGNING_CONF_PRIVATE_KEY_PASSWD_ENTRY="PQCPASS"
PQC_SIGNING_CONF_PRIVATE_KEY_FILE_ENTRY="PQCPRIVKEYFILE"
PQC_SIGNING_CONF_PUBLIC_KEY_FILE_ENTRY="PQCPUBKEYFILE"
PQC_SIGNING_CONF_CERTIFICATE_FILE_ENTRY="PQCCERTFILE"

function check_openssl_available {
    if command -v /usr/bin/openssl >&2>/dev/null; then
        #openssl is available
        :
    else
        echo "Error: /usr/bin/openssl is not available"
        exit 1
    fi
}

function check_openssl_min_version {
    OPENSSL_VER=$(rpm -qf --queryformat='%{VERSION}' /usr/bin/openssl)

    if { echo "$PQC_MIN_OPENSSL_VER"; echo "$OPENSSL_VER"; } | sort --version-sort --check ; then
        #version is ok
        :
    else
        echo "Error: /usr/bin/openssl must be at least of version ${PQC_MIN_OPENSSL_VER}"
        exit 1
    fi
}

function generate_pqc_key_pair_certificate {
    #remove if present, create dirs
    rm -f $PQC_PRIVATE_KEY_FILE
    mkdir -p "$(dirname "$PQC_PRIVATE_KEY_FILE")"
    rm -f $PQC_PUBLIC_KEY_FILE
    mkdir -p "$(dirname "$PQC_PUBLIC_KEY_FILE")"

    #PQC key pair
    export ENV_PQC_KEY_PWD="$PQC_PRIVATE_KEY_PASSWD"
    /usr/bin/openssl genpkey -algorithm mldsa87 -out $PQC_PRIVATE_KEY_FILE -outpubkey $PQC_PUBLIC_KEY_FILE -aes-256-cbc -pass env:ENV_PQC_KEY_PWD
    unset ENV_PQC_KEY_PWD

    chmod 400 $PQC_PRIVATE_KEY_FILE
    chmod 444 $PQC_PUBLIC_KEY_FILE
    echo "Generated PQC private key: ${PQC_PRIVATE_KEY_FILE}"
    echo "Generated PQC public key: ${PQC_PUBLIC_KEY_FILE}"

    #remove if present, create dirs
    rm -f $PQC_CERTIFICATE_FILE
    mkdir -p "$(dirname "$PQC_CERTIFICATE_FILE")"

    #certificate
    export ENV_PQC_KEY_PWD="$PQC_PRIVATE_KEY_PASSWD"
    /usr/bin/openssl x509 -new -key $PQC_PRIVATE_KEY_FILE -passin env:ENV_PQC_KEY_PWD -subj "${PQC_CERTIFICATE_SUBJECT}" > $PQC_CERTIFICATE_FILE
    unset ENV_PQC_KEY_PWD

    chmod 444 $PQC_CERTIFICATE_FILE
    echo "Generated PQC certificate: ${PQC_CERTIFICATE_FILE}"
    /usr/bin/openssl x509 -in "${PQC_CERTIFICATE_FILE}" -noout -subject
}

function do_generate_pqc_key {
    #check openssl is available
    check_openssl_available

    #check openssl is at least of version >= 3.5
    check_openssl_min_version

    #remove exported certificates
    remove_pqc_public_certificate_from_salt_dir
    remove_pqc_public_certificate_to_http_pub_dir

    #ask password to protect private key
    ask_pqc_private_key_password

    #save password and filenames in signing.conf
    save_to_config_file "$SIGNING_CONF" "$PQC_SIGNING_CONF_PRIVATE_KEY_PASSWD_ENTRY" "$PQC_PRIVATE_KEY_PASSWD" "#PQC PASSPHRASE"
    save_to_config_file "$SIGNING_CONF" "$PQC_SIGNING_CONF_PRIVATE_KEY_FILE_ENTRY" "$PQC_PRIVATE_KEY_FILE" "#PQC PRIVATE KEY FILE"
    save_to_config_file "$SIGNING_CONF" "$PQC_SIGNING_CONF_PUBLIC_KEY_FILE_ENTRY" "$PQC_PUBLIC_KEY_FILE" "#PQC PUBLIC KEY FILE"
    save_to_config_file "$SIGNING_CONF" "$PQC_SIGNING_CONF_CERTIFICATE_FILE_ENTRY" "$PQC_CERTIFICATE_FILE" "#PQC CERTIFICATE FILE"

    #create PQC key pair
    generate_pqc_key_pair_certificate
}



function is_pqc_metadata_signing_enabled {
    grep --quiet "^${PQC_RHN_CONF_SIGN_ENTRY}.*=.*1\s*$" $RHN_CONF
}

function ensure_pqc_metadata_signing_key_exists {
    if [ ! -f "$PQC_PRIVATE_KEY_FILE" ]; then
        echo "ERROR. No PQC private key to sign metadata has been created."
        echo "You may want to run 'mgr-pqc-sign-metadata-ctl generate-key'"
        exit 1
    fi
    if [ ! -f "$PQC_PUBLIC_KEY_FILE" ]; then
        echo "ERROR. No PQC public key to sign metadata has been created."
        echo "You may want to run 'mgr-pqc-sign-metadata-ctl generate-key'"
        exit 1
    fi
    if [ ! -f "$PQC_CERTIFICATE_FILE" ]; then
        echo "ERROR. No PQC certificate key to sign metadata has been created."
        echo "You may want to run 'mgr-pqc-sign-metadata-ctl generate-key'"
        exit 1
    fi

    echo "OK. Key ${PQC_CERTIFICATE_FILE}."
}

function ensure_pqc_metadata_signing_entry_rhn_conf {
    # make sure PQC sign metadata entry =1 in rhn.conf
    if grep --quiet "^${PQC_RHN_CONF_SIGN_ENTRY}.*=.*0\s*$" $RHN_CONF; then
        # edit rhn.conf to enable signing
        sed -i "s/${PQC_RHN_CONF_SIGN_ENTRY}.*=.*$/${PQC_RHN_CONF_SIGN_ENTRY} = 1/g" $RHN_CONF
        echo "DONE. Enabled PQC metadata signing in ${RHN_CONF}."

    elif grep --quiet "^${PQC_RHN_CONF_SIGN_ENTRY}.*=.*1" $RHN_CONF; then
        echo "OK. PQC Metadata signing is enabled in ${RHN_CONF}."
    else
        # add line to rhn.conf
        echo "${PQC_RHN_CONF_SIGN_ENTRY} = 1" >> $RHN_CONF
        echo "DONE. Enabled PQC metadata signing in ${RHN_CONF}."
    fi
}

function export_pqc_public_certificate_to_salt_dir {
    rm -f "$PQC_SALT_EXPORT_CERTIFICATE_FILE"

    mkdir -p "$PQC_SALT_EXPORT_DIR"
    chown salt:salt "$PQC_SALT_EXPORT_DIR"
    chmod 775 "$PQC_SALT_EXPORT_DIR"

    cp -fa "$PQC_CERTIFICATE_FILE" "$PQC_SALT_EXPORT_CERTIFICATE_FILE"
    chmod 644 ${PQC_SALT_EXPORT_CERTIFICATE_FILE}
    echo "DONE. Exported public PQC certificate to ${PQC_SALT_EXPORT_CERTIFICATE_FILE}."
}

function remove_pqc_public_certificate_from_salt_dir {
    if [ -f "$PQC_SALT_EXPORT_CERTIFICATE_FILE" ]; then
        rm -f "$PQC_SALT_EXPORT_CERTIFICATE_FILE"
        echo "DONE. Removed key export file ${PQC_SALT_EXPORT_CERTIFICATE_FILE}."
    else
        echo "OK. Key file ${PQC_SALT_EXPORT_CERTIFICATE_FILE} is not present."
    fi
}

function export_pqc_public_certificate_to_http_pub_dir {
    rm -f "$PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE"

    cp -fa "$PQC_CERTIFICATE_FILE" "$PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE"
    chmod 644 ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE}
    echo "DONE. Exported public PQC certificate to ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE}."
}

function remove_pqc_public_certificate_to_http_pub_dir {
    if [ -f "$PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE" ]; then
        rm -f "$PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE"
        echo "DONE. Removed key export file ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE}."
    else
        echo "OK. Key file ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE} is not present."
    fi
}

function do_enable_pqc_metadata_signing {
    # read info from config file
    read_from_config_file
    # check if the PQC signing key exists
    ensure_pqc_metadata_signing_key_exists
    # make sure PQC sign metadata entry =1 in rhn.conf
    ensure_pqc_metadata_signing_entry_rhn_conf
    # export the PQC public certificate to the salt dir
    export_pqc_public_certificate_to_salt_dir
    # export the PQC public certificate to the http pub dir
    export_pqc_public_certificate_to_http_pub_dir
}


function do_check_pqc_metadata_signing {
    # check PQC sign metadata entry in rhn.conf
    if is_pqc_metadata_signing_enabled; then
        echo "Metadata PQC signing is enabled in ${RHN_CONF}."
        echo

        # check salt key export file
        if [ -f "$PQC_SALT_EXPORT_CERTIFICATE_FILE" ]; then
            echo "OK. Public PQC certificate was exported to ${PQC_SALT_EXPORT_CERTIFICATE_FILE}."
        else
            echo "ERROR. Public PQC certificate file $PQC_SALT_EXPORT_CERTIFICATE_FILE is missing."
        fi

        # check pub key export file
        if [ -f "$PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE" ]; then
            echo "OK. Public PQC certificate was exported to ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE}."
        else
            echo "ERROR. Public PQC certificate file $PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE is missing."
        fi

    else
        echo "Metadata PQC signing is DISABLED in ${RHN_CONF}."
        echo

        # check salt key export file
        if [ -f "$PQC_SALT_EXPORT_CERTIFICATE_FILE" ]; then
            echo "WARNING. Public PQC certificate export file ${PQC_SALT_EXPORT_CERTIFICATE_FILE} is present."
        else
            echo "OK. Public PQC certificate file ${PQC_SALT_EXPORT_CERTIFICATE_FILE} is not present."
        fi

        # check http pub key export file
        if [ -f "$PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE" ]; then
            echo "WARNING. Public PQC certificate export file ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE} is present."
        else
            echo "OK. Public PQC certificate file ${PQC_HTTP_PUB_EXPORT_CERTIFICATE_FILE} is not present."
        fi
    fi
}


function do_disable_pqc_metadata_signing {
    if grep --quiet "^${PQC_RHN_CONF_SIGN_ENTRY}.*=.*$" $RHN_CONF; then
        # edit rhn.conf to disable signing
        sed -i "s/${PQC_RHN_CONF_SIGN_ENTRY}.*=.*$/${PQC_RHN_CONF_SIGN_ENTRY} = 0/g" $RHN_CONF
    else
        # add line to rhn.conf
        echo "${PQC_RHN_CONF_SIGN_ENTRY} = 0" >> $RHN_CONF
    fi
    echo "DONE. Disabled PQC metadata signing in ${RHN_CONF}."

    remove_pqc_public_certificate_from_salt_dir

    remove_pqc_public_certificate_to_http_pub_dir
}


function warn_effective_changes {
    echo
    echo "NOTE. For the changes to become effective run:"
    echo "   mgr-pqc-sign-metadata-ctl regen-metadata"
    echo "and schedule a highstate for all your systems to"
    echo "apply the new repository configuration."
    echo
}



function read_spacecmd_user_pass {
    if [[ -z "$SPACECMD_USER" || -z "$SPACECMD_PASS" ]];then
        echo -n "Server User: ";
        read -r SPACECMD_USER
        echo -n "Server Password: ";
        read -r -s SPACECMD_PASS
    fi
    echo
}

function do_check_channels {
    if is_pqc_metadata_signing_enabled; then
        read_spacecmd_user_pass
        CHANNELS=$(spacecmd -q -u $SPACECMD_USER -p $SPACECMD_PASS softwarechannel_list)
        RETVAL=$?
        if [ $RETVAL -ne 0 ]; then
            exit 1
        fi
        REPODATA_DIR="$(spacewalk-cfg-get repomd_cache_mount_point)/rhn/repodata"

        for ch in $CHANNELS; do
            if [ ! -d "$REPODATA_DIR/$ch" ]; then
                echo "ERROR. Channel $ch. Cached metadata not generated."
            else
                # Trick to define if a repository is Debian/Ubuntu:
                # if a file named “$REPODATA_DIR/$ch/Release” is found, then it's debian/ubuntu
                if [[ -f "$REPODATA_DIR/$ch/Release" ]]; then
                    #debian/ubuntu case: at the moment do nothing
                    echo "OK. Channel $ch not supporting PQC at the moment."
                else
                      if [[ -f "$REPODATA_DIR/$ch/$PQC_CUSTOM_SIGNATURE_FILENAME" ]]; then
                          echo "OK. Channel $ch. Cached metadata is PQC-signed."
                      else
                          echo "ERROR. Channel $ch. Cached metadata is not PQC-signed."
                      fi
                fi
            fi
        done
    else
        echo "No checking done. Metadata PQC signing is disabled."
    fi
}



function do_regenerate_metadata {
    echo -n "Restarting Tomcat..."
    systemctl restart tomcat
    echo "done."
    echo -n "Restarting Taskomatic..."
    systemctl restart taskomatic
    echo "done."
    echo
    read_spacecmd_user_pass
    echo "Refreshing pillar data..."
    spacecmd -q -u $SPACECMD_USER -p $SPACECMD_PASS "system_refreshpillar"
    echo "Scheduling repo metadata regeneration..."
    spacecmd -q -u $SPACECMD_USER -p $SPACECMD_PASS "softwarechannel_regenerateyumcache -f *"
    RETVAL=$?
    if [ $RETVAL -ne 0 ]; then
        echo "\nERROR queuing repo metadata regeneration. Try executing manually: spacecmd softwarechannel_regenerateyumcache \"*\""
        exit 1
    fi
    echo "done."
}

function save_to_config_file {
  CONFIG_FILE=$1
  KEY_TO_SAVE=$2
  VALUE_TO_SAVE=$3
  COMMENT_ABOVE=$4

  if [ ! -r $CONFIG_FILE ]; then
      echo "No config file found: ${CONFIG_FILE}" >&2
      exit 1
  fi

  # make sure key is in configuration file
  if grep --quiet "^${KEY_TO_SAVE}.*=.*$" $CONFIG_FILE; then
      # edit configuration file to save key value
      sed -i "s|${KEY_TO_SAVE}=\".*\"\s*$|${KEY_TO_SAVE}=\"${VALUE_TO_SAVE}\"|g" "$CONFIG_FILE"
      echo "DONE. Saved ${KEY_TO_SAVE} in ${CONFIG_FILE}."
  else
      # add line to configuration file
      echo "" >> "$CONFIG_FILE"
      echo "${COMMENT_ABOVE}" >> "$CONFIG_FILE"
      echo "${KEY_TO_SAVE}=\"${VALUE_TO_SAVE}\"" >> "$CONFIG_FILE"
      echo "DONE. Saved new ${KEY_TO_SAVE} in ${CONFIG_FILE}."
  fi
}

function read_from_config_file {
    source $SIGNING_CONF

    #check for variables to exists AND not to be empty
    if [[ -z "${!PQC_SIGNING_CONF_PRIVATE_KEY_PASSWD_ENTRY:-}" ]]; then
      echo "Unable to find PQC password in config file $SIGNING_CONF" >&2
      exit 1
    fi
    if [[ -z "${!PQC_SIGNING_CONF_PRIVATE_KEY_FILE_ENTRY:-}" ]]; then
      echo "Unable to find PQC private key file in config file $SIGNING_CONF" >&2
      exit 1
    fi
    if [[ -z "${!PQC_SIGNING_CONF_PUBLIC_KEY_FILE_ENTRY:-}" ]]; then
      echo "Unable to find PQC public key file in config file $SIGNING_CONF" >&2
      exit 1
    fi
    if [[ -z "${!PQC_SIGNING_CONF_CERTIFICATE_FILE_ENTRY:-}" ]]; then
      echo "Unable to find PQC certificate key file in config file $SIGNING_CONF" >&2
      exit 1
    fi

    PQC_PRIVATE_KEY_PASSWD="${!PQC_SIGNING_CONF_PRIVATE_KEY_PASSWD_ENTRY}"
    PQC_PRIVATE_KEY_FILE="${!PQC_SIGNING_CONF_PRIVATE_KEY_FILE_ENTRY}"
    PQC_PUBLIC_KEY_FILE="${!PQC_SIGNING_CONF_PUBLIC_KEY_FILE_ENTRY}"
    PQC_CERTIFICATE_FILE="${!PQC_SIGNING_CONF_CERTIFICATE_FILE_ENTRY}"
}

function ask_pqc_private_key_password {
  while true; do
      read -s -p "Enter PQC private key password: " PQC_PRIVATE_KEY_PASSWD
      echo ""
      read -s -p "Confirm PQC private key password: " PASSWD_CHECK
      echo ""

      if [[ "$PQC_PRIVATE_KEY_PASSWD" != "$PASSWD_CHECK" ]]; then
          echo "Error: Passwords do not match. Try again."
          continue
      fi

      break
  done
}

function check_absolute_file_path {
    FILE_PATH="$1"

    #Checks the path starts with '/'
    if [[ "$FILE_PATH" != /* ]]; then
        echo "Error: '$FILE_PATH' is not an absolute path (must start with '/')." >&2
        exit 1
    fi

    #Checks it does not end with '/' (file, not directory)
    if [[ "$FILE_PATH" == */ ]]; then
        echo "Error: '$FILE_PATH' ends with a slash." >&2
        exit 1
    fi
}

function usage {
    echo "Usage: mgr-pqc-sign-metadata-ctl [generate-key [options] | enable | disable | check-channels | check-config | regen-metadata]"
    echo "  generate-key    Generates PQC keys and certificate and enables PQC signing of repository metadata."
    echo "                   Optional Arguments:"
    echo "                   -s|--subj <cert_subj> Certificate subject. E.g. '/CN=Company PQC Key/O=My Company/emailAddress=me@example.com']"
    echo "                         (default: $PQC_DEFAULT_CERTIFICATE_SUBJECT)"
    echo "                   -p|--priv <pqc_private_key_filename> Private key file name (absolute path)"
    echo "                         (default: $PQC_DEFAULT_PRIVATE_KEY_FILE)"
    echo "                   -u|--pub <pqc_public_key_filename> Public key file name (absolute path)"
    echo "                         (default: $PQC_DEFAULT_PUBLIC_KEY_FILE)"
    echo "                   -c|--cert <pqc_certificate_filename> Certificate file name (absolute path)"
    echo "                         (default: $PQC_DEFAULT_CERTIFICATE_FILE)"
    echo "  enable          Enable PQC signing of repository metadata."
    echo "  disable         Disable PQC signing of repository metadata."
    echo "  check-channels  Check if the cached channels repodata is signed."
    echo "  check-config    Check configuration and report any problems. This is the default option."
    echo "  regen-metadata  Restart services and schedule metadata regeneration."
}

#defaults
PQC_CERTIFICATE_SUBJECT=$PQC_DEFAULT_CERTIFICATE_SUBJECT
PQC_PRIVATE_KEY_FILE=$PQC_DEFAULT_PRIVATE_KEY_FILE
PQC_PUBLIC_KEY_FILE=$PQC_DEFAULT_PUBLIC_KEY_FILE
PQC_CERTIFICATE_FILE=$PQC_DEFAULT_CERTIFICATE_FILE

if [ -n "$1" ]; then

    if [[  "$1" = "generate-key" ]]; then
          shift
          while [[ $# -gt 0 ]]; do
            case "$1" in
                -s|--subj)
                    if [[ -n "$2" && "$2" != -* ]]; then
                        PQC_CERTIFICATE_SUBJECT="$2"
                        shift 2
                    else
                        echo "Error: -s|--subj requires a certificate subject." >&2
                        usage
                        exit 1
                    fi
                    ;;
                -p|--priv)
                    if [[ -n "$2" && "$2" != -* ]]; then
                        PQC_PRIVATE_KEY_FILE="$2"
                        check_absolute_file_path "$2"
                        shift 2
                    else
                        echo "Error: -p|--priv requires a private key filename argument." >&2
                        usage
                        exit 1
                    fi
                    ;;
                -u|--pub)
                    if [[ -n "$2" && "$2" != -* ]]; then
                        PQC_PUBLIC_KEY_FILE="$2"
                        check_absolute_file_path "$2"
                        shift 2
                    else
                        echo "Error: -u|--pub requires a public key filename argument." >&2
                        usage
                        exit 1
                    fi
                    ;;
                -c|--cert)
                    if [[ -n "$2" && "$2" != -* ]]; then
                        PQC_CERTIFICATE_FILE="$2"
                        check_absolute_file_path "$2"
                        shift 2
                    else
                        echo "Error: -c|--cert requires a certificate filename argument." >&2
                        usage
                        exit 1
                    fi
                    ;;
                *)
                    echo "Error: Unknown option '$1' for generate-key." >&2
                    usage
                    exit 1
                    ;;
            esac
        done
        do_generate_pqc_key
        do_enable_pqc_metadata_signing
        do_check_pqc_metadata_signing
        warn_effective_changes
    elif [[  "$1" = "enable" ]]; then
        do_enable_pqc_metadata_signing
        warn_effective_changes
    elif [[  "$1" = "disable" ]]; then
        do_disable_pqc_metadata_signing
        warn_effective_changes
    elif [[  "$1" = "check-channels" ]]; then
        do_check_channels
    elif [[  "$1" = "check-config" ]]; then
        do_check_pqc_metadata_signing
    elif [[  "$1" = "regen-metadata" ]]; then
        do_regenerate_metadata
    elif [[ "$1" = "help" || "$1" = "--help" || "$1" = "-h" ]]; then
        usage
        exit 0
    else
        usage
        exit 1
    fi

    exit 0
else
    do_check_pqc_metadata_signing
    exit 0
fi

