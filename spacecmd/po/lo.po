#: ../src/spacecmd/activationkey.py:787
msgid "activationkey_create: Create an activation key"
msgstr "activationkey_create: ສ້າງຄີການເປີດໃຊ້"

#: ../src/spacecmd/activationkey.py:790
msgid ""
"usage: activationkey_create [options])\n"
"\n"
"options:\n"
"  -n NAME\n"
"  -d DESCRIPTION\n"
"  -b BASE_CHANNEL\n"
"  -u set key as universal default\n"
"  -e [enterprise_entitled,virtualization_host]"
msgstr ""
"ວິທີໃຊ້: activationkey_create [options])\n"
"\n"
"ຕົວເລືອກ:\n"
"  -n NAME ຊື່\n"
"  -d DESCRIPTION ຄຳອະທິບາຍ\n"
"  -b BASE_CHANNEL ຊ່ອງທາງຫຼັກ\n"
"  -u ກຳນົດຄີເປັນຄ່າເລີ່ມຕົ້ນສາກົນ\n"
"  -e [enterprise_entitled,virtualization_host]"

