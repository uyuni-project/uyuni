def check_and_configure_fips():
    fips_enabled = False
    fips_path = Path("/proc/sys/crypto/fips_enabled")
    try:
        fips_enabled = fips_path.read_text(encoding="utf-8").strip() == "1"
    except FileNotFoundError:
        return
    except OSError as error:
        sys.stderr.write(f"Failed to read FIPS status: {error}\n")
        sys.stderr.flush()
        return

    if fips_enabled:
        result = subprocess.run(
            ["/usr/bin/update-crypto-policies", "--set", "FIPS"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            encoding="utf-8",
            check=False,
        )
        if result.stdout:
            sys.stdout.write(f"{result.stdout}\n")
            sys.stdout.flush()
        if result.returncode:
            sys.stdout.write("Failed to set crypto policy to FIPS!\n")
            sys.stdout.flush()


def run_uyuni_configfiles_sync():
    if not os.path.isfile("/usr/bin/uyuni-configfiles-sync"):
        return 0

    exitCode = 0
    result = subprocess.run(
        ["/usr/bin/uyuni-configfiles-sync", "sync"],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        encoding="utf-8",
        check=False,
    )

    if result.stdout:
        sys.stdout.write(f"{result.stdout}\n")
        sys.stdout.flush()
    if result.returncode:
        sys.stdout.write(
            "Failed to synchronize files to persistent volumes. Aborting!\n"
        )
        sys.stdout.flush()
        exitCode = 1
    return exitCode


def moved_keys(keys, prefixes):
    """
    Map the names a key can have in rhn.conf to the key in the rhnConfiguration table.
    The key in the database is the name in the configuration defaults with dots replaced
    by underscores in upper case. In rhn.conf the key can be written with or without
    the namespace prefixes.
    """
    result = {}
    for key in keys:
        db_key = key.replace(".", "_").upper()
        result[key] = db_key
        for prefix in prefixes:
            if key.startswith(prefix):
                result[key[len(prefix) :]] = db_key
            else:
                result[prefix + key] = db_key
    return result


