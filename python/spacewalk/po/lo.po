#, python-format
msgid "Invalid request received (%s)."
msgstr "ໄດ້ຮັບການຮ້ອງຂໍທີ່ບໍ່ຖືກຕ້ອງ (%s)."

#. Send the message as a fault.
#: ../server/apacheRequest.py:130
#, python-format
