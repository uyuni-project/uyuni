include /templates/common.jade

#list-ldap

div#init_data_ldap_servers(style="display: none")
    | #{contentLdapServers}

script(type='text/javascript').
    spaImportReactPage('admin/setup/list-ldap')
        .then(function(module) {
            module.renderer(
                'list-ldap',
                {
                    ldap_servers: document.getElementById('init_data_ldap_servers').textContent,
                    flashMessage: "#{flashMessage}"
                }
            );
        });
