msgstr "ມີການຮ້ອງຂໍແພັກເກດ RPM %s ທີ່ບໍ່ຖືກຕ້ອງ"

#: ../server/rhnPackage.py:123
msgid "Package not found"
msgstr "ບໍ່ພົບແພັກເກດ"

#: ../server/rhnServer/server_class.py:103
#, python-format
msgid "Architecture `%s' is not supported"
msgstr "ບໍ່ຮອງຮັບສະຖາປັດຕະຍະກຳ `%s'"

#: ../server/rhnServer/server_token.py:86
#, python-format
msgid "Token `%s' has more than one base channel assigned"
msgstr "ໂທເຄັນ `%s' ມີການກຳນົດຊ່ອງທາງຫຼັກຫຼາຍກວ່າໜຶ່ງຊ່ອງທາງ"

#: ../server/rhnServer/server_token.py:89
msgid "Conflicting base channels"
msgstr "ຊ່ອງທາງຫຼັກຂັດແຍ້ງກັນ"

#: ../server/rhnServer/server_token.py:223
#, python-format
msgid "Failed to add server to group %s"
msgstr "ບໍ່ສາມາດເພີ່ມເຊີເວີເຂົ້າໃນກຸ່ມ %s"

#: ../server/rhnServer/server_token.py:574
#, python-format
msgid "Maximum usage count of %s reached"
msgstr "ຈຳນວນການໃຊ້ງານສູງສຸດ %s ເຕັມແລ້ວ"

#: ../server/rhnServer/server_token.py:866
msgid "Stacking of re-registration tokens with different base entitlements is not supported"
msgstr "ບໍ່ຮອງຮັບການຊ້ອນກັນຂອງໂທເຄັນການລົງທະບຽນໃໝ່ທີ່ມີສິດພື້ນຖານຕ່າງກັນ"

#: ../server/rhnServer/server_token.py:943
#, python-format
msgid "Could not find token '%s'"
msgstr "ບໍ່ພົບໂທເຄັນ '%s'"

#. Cannot use activation keys from different orgs
#: ../server/rhnServer/server_token.py:976
msgid "Tokens from mismatching orgs"
msgstr "ໂທເຄັນມາຈາກອົງກອນທີ່ບໍ່ກົງກັນ"

#. Two tokens with different kickstart sessions
#: ../server/rhnServer/server_token.py:986
msgid "Kickstart session mismatch"
msgstr "ເຊດຊັນ Kickstart ບໍ່ກົງກັນ"

#: ../server/rhnServer/server_token.py:1010
msgid "Stacking of re-registration tokens is not supported"
msgstr "ບໍ່ຮອງຮັບການຊ້ອນກັນຂອງໂທເຄັນການລົງທະບຽນໃໝ່"

#: ../server/rhnUser.py:321 ../server/rhnUser.py:324
msgid "Invalid username/password combination"
msgstr "ຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານ ບໍ່ຖືກຕ້ອງ"

#. nope, not reserved either
#: ../server/rhnUser.py:505
#, python-format
msgid "Username `%s' has not been reserved"
msgstr "ຊື່ຜູ້ໃຊ້ `%s' ບໍ່ໄດ້ຖືກຈອງໄວ້"

#. New accounts have to specify an e-mail address
#: ../server/rhnUser.py:511
msgid "E-mail address not specified"
msgstr "ບໍ່ໄດ້ລະບຸທີ່ຢູ່ອີເມລ"

#: ../server/rhnUser.py:553
#, python-format
msgid "username should be at least %d characters"
msgstr "ຊື່ຜູ້ໃຊ້ຄວນມີຢ່າງໜ້ອຍ %d ຕົວອັກສອນ"

#: ../server/rhnUser.py:557
#, python-format
msgid "username should be less than %d characters"
msgstr "ຊື່ຜູ້ໃຊ້ຄວນມີໜ້ອຍກວ່າ %d ຕົວອັກສອນ"

#: ../server/rhnUser.py:571
#, python-format
msgid "username = `%s', invalid character `%s'"
msgstr "ຊື່ຜູ້ໃຊ້ = `%s', ມີຕົວອັກສອນທີ່ບໍ່ຖືກຕ້ອງ `%s'"

#: ../server/rhnUser.py:592
#, python-format
msgid "Please limit your e-mail address to %s chars"
msgstr "ກະລຸນາຈຳກັດທີ່ຢູ່ອີເມລຂອງທ່ານບໍ່ໃຫ້ເກີນ %s ຕົວອັກສອນ"

#: ../server/rhnUser.py:690
#, python-format
msgid "password must be at least %d characters"
msgstr "ລະຫັດຜ່ານຕ້ອງມີຢ່າງໜ້ອຍ %d ຕົວອັກສອນ"

#: ../server/rhnUser.py:694
#, python-format
msgid "Password must be shorter than %d characters"
msgstr "ລະຫັດຜ່ານຕ້ອງສັ້ນກວ່າ %d ຕົວອັກສອນ"

#: ../server/rhnUser.py:710
#, python-format
msgid "password contains character `%s'"
msgstr "ລະຫັດຜ່ານມີຕົວອັກສອນ `%s'"

#: ../server/rhnUser.py:719
#, python-format
msgid "username should be at least %d characters long"
msgstr "ຊື່ຜູ້ໃຊ້ຄວນມີຄວາມຍາວຢ່າງໜ້ອຍ %d ຕົວອັກສອນ"

#: ../server/rhnUser.py:730
#, python-format
msgid "Cannot register usernames ending with %s"
msgstr "ບໍ່ສາມາດລົງທະບຽນຊື່ຜູ້ໃຊ້ທີ່ລົງທ້າຍດ້ວຍ %s"

#. 0-999: Red Hat client/client-like interaction errors:
#: ../common/rhnException.py:55
msgid "This does not appear to be a valid username."
msgstr "ເບິ່ງຄືວ່າບໍ່ແມ່ນຊື່ຜູ້ໃຊ້ທີ່ຖືກຕ້ອງ."

#: ../common/rhnException.py:56
msgid "Invalid username and password combination."
msgstr "ການລວມກັນຂອງຊື່ຜູ້ໃຊ້ ແລະ ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

#: ../common/rhnException.py:57
msgid "This login is already taken, or the password is incorrect."
msgstr "ຊື່ເຂົ້າລະບົບນີ້ມີຜູ້ໃຊ້ແລ້ວ ຫຼື ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ."

#: ../common/rhnException.py:58
msgid "Permission denied."
msgstr "ຖືກປະຕິເສດການເຂົ້າເຖິງ."

#: ../common/rhnException.py:59
msgid "Object not found."
msgstr "ບໍ່ພົບວັດຖຸ."

#: ../common/rhnException.py:60
msgid "Invalid System Digital ID."
msgstr "ໄອດີດິຈິຕອນຂອງລະບົບບໍ່ຖືກຕ້ອງ."

#: ../common/rhnException.py:61
msgid "Invalid System Credentials."
msgstr "ຂໍ້ມູນປະຈຳຕົວຂອງລະບົບບໍ່ຖືກຕ້ອງ."

#: ../common/rhnException.py:62
