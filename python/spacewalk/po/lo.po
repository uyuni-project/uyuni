#: ../server/apacheAuth.py:80
#, python-format
msgid "incomplete proxy authentication token: %s"
msgstr "ໂທເຄັນການຢືນຢັນຕົວຕົນພຣັອກຊີບໍ່ສົມບູນ: %s"

#: ../server/apacheAuth.py:111
#, python-format
msgid "Sent proxy signature %s does not match ours %s."
msgstr "ລາຍເຊັນພຣັອກຊີ %s ທີ່ສົ່ງມາ ບໍ່ກົງກັບຂອງພວກເຮົາ %s."

#: ../server/apacheAuth.py:150
msgid "declined proxy authentication"
msgstr "ປະຕິເສດການຢືນຢັນຕົວຕົນພຣັອກຊີ"

#: ../server/apacheRequest.py:68
#, python-format
msgid "Invalid request received (%s)."
msgstr "ໄດ້ຮັບຄຳຮ້ອງຂໍທີ່ບໍ່ຖືກຕ້ອງ (%s)."

#. Send the message as a fault.
#: ../server/apacheRequest.py:130
#, python-format
msgid ""
"IMPORTANT MESSAGE FOLLOWS:\n"
"%s"
msgstr ""
"ຂໍ້ຄວາມສຳຄັນມີດັ່ງນີ້:\n"
"%s"

#: ../server/apacheRequest.py:160
#, python-format
msgid ""
"While running '%s': caught\n"
"%s : %s\n"
msgstr ""
"ໃນຂະນະທີ່ກຳລັງເຮັດວຽກ '%s': ພົບຂໍ້ຜິດພາດ\n"
"%s : %s\n"

#. pylint: disable-next=consider-using-f-string
#: ../server/apacheRequest.py:675
#, python-format
msgid "Invalid URI %s"
msgstr "URI %s ບໍ່ຖືກຕ້ອງ"

#: ../server/handlers/app/packages.py:220
#, python-format
msgid ""
"\n"
"                   %s Account has been deactivated on this server.\n"
"                   Please contact your Org administrator for more help."
msgstr ""
"\n"
"                   ບັນຊີ %s ຖືກປິດການໃຊ້ງານໃນເຊີເວີນີ້ແລ້ວ.\n"
"                   ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບອົງກອນຂອງທ່ານເພື່ອຂໍຄວາມຊ່ວຍເຫຼືອເພີ່ມເຕີມ."

#: ../server/handlers/xmlrpc/proxy.py:71
#, python-format
msgid "SUSE Multi-Linux Manager Proxy service not enabled for server profile: \"%s\""
msgstr "ບໍລິການ SUSE Multi-Linux Manager Proxy ບໍ່ໄດ້ຖືກເປີດໃຊ້ສຳລັບໂປຣໄຟລ໌ເຊີເວີ: \"%s\""

#: ../server/handlers/xmlrpc/proxy.py:94
msgid "Invalid session key"
msgstr "ຄີເຊດຊັນ (session key) ບໍ່ຖືກຕ້ອງ"

#: ../server/handlers/xmlrpc/proxy.py:102
msgid "This server ID no longer exists"
msgstr "ໄອດີເຊີເວີນີ້ບໍ່ມີອີກຕໍ່ໄປແລ້ວ"

#: ../server/importlib/userAuth.py:109
msgid "You are not authorized to manage packages in the null org"
msgstr "ທ່ານບໍ່ມີສິດຈັດການແພັກເກດໃນອົງກອນທີ່ວ່າງເປົ່າ (null)"

#: ../server/importlib/userAuth.py:115
#, python-format
msgid "You are not allowed to manage packages in the %s org"
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຈັດການແພັກເກດໃນອົງກອນ %s"

#. ok, you're a regular user who doesn't manage any channels.
#. take a hike.
#: ../server/importlib/userAuth.py:132
msgid "You are not allowed to perform administrative tasks"
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ປະຕິບັດໜ້າທີ່ການດູແລລະບົບ"

#: ../server/importlib/userAuth.py:159
#, python-format
msgid "You are not allowed to manage channel %s, or that channel does not exist"
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຈັດການຊ່ອງທາງ %s, ຫຼື ຊ່ອງທາງນັ້ນບໍ່ມີຢູ່"

#: ../server/importlib/userAuth.py:229
#, python-format
msgid ""
"\n"
"               %s Account has been deactivated on this server.\n"
"               Please contact your Org administrator for more help."
msgstr ""
"\n"
"               ບັນຊີ %s ຖືກປິດການໃຊ້ງານໃນເຊີເວີນີ້ແລ້ວ.\n"
"               ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບອົງກອນຂອງທ່ານເພື່ອຂໍຄວາມຊ່ວຍເຫຼືອເພີ່ມເຕີມ."

#: ../server/rhnChannel.py:2216
#, python-format
msgid "Your account does not have access to any channels matching (release='%(release)s', arch='%(arch)s')%(www_activation)s"
msgstr "ບັນຊີຂອງທ່ານບໍ່ສາມາດເຂົ້າເຖິງຊ່ອງທາງໃດໆທີ່ກົງກັບ (ລຸ້ນ='%(release)s', ສະຖາປັດຕະຍະກຳ='%(arch)s')%(www_activation)s"

#: ../server/rhnChannel.py:2235
#, python-format
msgid "Insufficient subscription permissions for release (%s, %s"
msgstr "ສິດການສະໝັກໃຊ້ບໍ່ພຽງພໍສຳລັບລຸ້ນ (%s, %s)"

#. Various messages that can be reused
#.
#. bretm 02/07/2007 -- when we have better old-client documentation, probably
#. will be safe to get rid of all this crap
#: ../server/rhnChannel.py:2549 ../server/rhnChannel.py:2568
msgid "System Registered but Inactive"
msgstr "ລະບົບລົງທະບຽນແລ້ວ ແຕ່ຍັງບໍ່ທັນເຮັດວຽກ"

#: ../server/rhnChannel.py:2551
#, python-format
msgid ""
"\n"
"Invalid Architecture and OS release combination (%s, %s).\n"
"Your system has been registered, but will not receive updates\n"
"because it could not be subscribed to a base channel.\n"
"Please contact your organization administrator for assistance.\n"
msgstr ""
"\n"
"ການລວມກັນຂອງສະຖາປັດຕະຍະກຳ ແລະ ລຸ້ນ OS ບໍ່ຖືກຕ້ອງ (%s, %s).\n"
"ລະບົບຂອງທ່ານໄດ້ລົງທະບຽນແລ້ວ, ແຕ່ຈະບໍ່ໄດ້ຮັບການອັບເດດ\n"
"ເນື່ອງຈາກບໍ່ສາມາດສະໝັກໃຊ້ຊ່ອງທາງຫຼັກ (base channel) ໄດ້.\n"
"ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບອົງກອນຂອງທ່ານເພື່ອຂໍຄວາມຊ່ວຍເຫຼືອ.\n"

#: ../server/rhnChannel.py:2560
#, python-format
msgid ""
"\n"
"  This system has been successfully registered, but is not yet entitled\n"
"  to service.  To entitle this system to service, login to the web site at:\n"
"\n"
"  %(entitlement_url)s\n"
msgstr ""
"\n"
"  ລະບົບນີ້ໄດ້ລົງທະບຽນສຳເລັດແລ້ວ, ແຕ່ຍັງບໍ່ທັນມີສິດໄດ້ຮັບບໍລິການ.\n"
"  ເພື່ອໃຫ້ລະບົບນີ້ມີສິດໃຊ້ບໍລິການ, ກະລຸນາເຂົ້າສູ່ລະບົບທີ່ເວັບໄຊ:\n"
"\n"
"  %(entitlement_url)s\n"

#: ../server/rhnChannel.py:2570
#, python-format
msgid ""
"\n"
"  This system has been successfully registered, but no service entitlements\n"
"  were available.  To entitle this system to service, login to the web site at:\n"
"\n"
"  %(entitlement_url)s\n"
msgstr ""
"\n"
"  ລະບົບນີ້ໄດ້ລົງທະບຽນສຳເລັດແລ້ວ, ແຕ່ບໍ່ມີສິດການໃຊ້ບໍລິການທີ່ຫວ່າງຢູ່.\n"
"  ເພື່ອໃຫ້ລະບົບນີ້ມີສິດໃຊ້ບໍລິການ, ກະລຸນາເຂົ້າສູ່ລະບົບທີ່ເວັບໄຊ:\n"
"\n"
"  %(entitlement_url)s\n"

