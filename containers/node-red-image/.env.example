# Copy to .env and set real passwords before starting the stack.
#
# The broker creates two accounts from these: uyuni-publisher, which may only
# write to uyuni/#, and uyuni-subscriber, which may only read from it.
#
# Point the Uyuni server at the broker with:
#   uyuni.mqtt.broker.username=uyuni-publisher
#   uyuni.mqtt.broker.password=<the publisher password below>
#
# In Node-RED, the uyuni-config node should use uyuni-subscriber.

MQTT_PUBLISHER_PASSWORD=change-me
MQTT_SUBSCRIBER_PASSWORD=change-me-too
