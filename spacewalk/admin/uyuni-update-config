def move_config_to_db():
    """
    Move configuration values from /etc/rhn/rhn.conf into the rhnConfiguration table
    """
    rhnSQL.initDB()

    with open("/etc/rhn/rhn.conf", "r", encoding="utf8") as f:
        lines = f.readlines()

    remaining = []
    for line in lines:
        match = re.match(r"^\s*([\w.]+)\s*=(.*)$", line)
        key = DB_CONFIG_KEYS.get(match.group(1).lower()) if match else None
        if not key or not move_configuration(key, match.group(2).strip()):
            remaining.append(line)

    if len(remaining) == len(lines):
        return
    rhnSQL.commit()
    with open("/etc/rhn/rhn.conf", "w", encoding="utf8") as f:
        f.writelines(remaining)


