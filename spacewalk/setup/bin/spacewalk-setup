import sys
import os
import argparse
import hashlib
import subprocess
import base64

DEFAULT_RHN_CONF_LOCATION = "/etc/rhn/rhn.conf"
PREP_RHN_CONF_LOCATION = "/var/lib/rhn/rhn-satellite-prep/etc/rhn/rhn.conf"


def load_answer_file(answer_file):
    answers = {}
    if not os.path.exists(answer_file):
        sys.stderr.write(f"Answer file {answer_file} not found.\n")
        sys.exit(1)

    with open(answer_file, "r", encoding="utf-8", errors="ignore") as f:
        for line in f:
            stripped = line.strip()
            if stripped.startswith("#") or not stripped:
                continue
            parts = stripped.split("=", 1)
            if len(parts) == 2:
                key = parts[0].strip()
                value = parts[1].strip()
                answers[key] = value
    return answers


def generate_secret():
    # 512 bytes of high-entropy urandom data hashed to SHA256 hex digest
    return hashlib.sha256(os.urandom(512)).hexdigest()


def update_config_file(file_path, options):
    if not os.path.exists(file_path):
        os.makedirs(os.path.dirname(file_path), exist_ok=True)
        with open(file_path, "w") as f:
            pass

    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        lines = f.readlines()

    new_lines = []
    keys_written = set()
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("#") or not stripped:
            new_lines.append(line)
            continue
        parts = stripped.split("=", 1)
        if len(parts) == 2:
            key = parts[0].strip()
            if key in options:
                new_lines.append(f"{key} = {options[key]}\n")
                keys_written.add(key)
                continue
        new_lines.append(line)

    # Append keys that weren't in the original file
    for key, value in sorted(options.items()):
        if key not in keys_written:
            new_lines.append(f"{key} = {value}\n")

    with open(file_path, "w", encoding="utf-8") as f:
        f.writelines(new_lines)


def run_sql(query):
    # Pipe SQL query to spacewalk-sql select direct mode
    try:
        proc = subprocess.Popen(
            ["spacewalk-sql", "--select-mode", "-"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        out, err = proc.communicate(input=query.encode("utf-8"))
        return out.decode("utf-8").strip(), err.decode("utf-8").strip(), proc.returncode
    except Exception as e:
        return "", str(e), 1


def main():
    parser = argparse.ArgumentParser(description="Uyuni Setup and Configuration Tool.")
    parser.add_argument(
        "--clear-db", action="store_true", help="Clear the database during setup"
    )
    parser.add_argument(
        "--answer-file",
        dest="answer_file",
        required=True,
        help="Answer file for non-interactive setup",
    )
    parser.add_argument(
        "--scc", action="store_true", help="Set up customer credentials (SCC)"
    )
    args = parser.parse_args()

    answers = load_answer_file(args.answer_file)
    hostname = answers.get("hostname", "").strip()

    if not hostname:
        sys.stderr.write("ERROR: Hostname not defined in answer file.\n")
        sys.exit(1)

    if hostname != hostname.lower():
        sys.stderr.write(
            f"ERROR: Hostname '{hostname}' of this server contains uppercase letters.\nIt can cause Proxy communications to fail.\n"
        )
        sys.exit(4)

    print("* Performing initial configuration.")

    # Generate high-entropy secrets
    secrets = {}
    for i in range(1, 5):
        secrets[f"session_secret_{i}"] = generate_secret()
        secrets[f"web.session_swap_secret_{i}"] = generate_secret()
    secrets["server.secret_key"] = generate_secret()

    # Define mapping of answers to rhn.conf options
    mapping = {
        "admin-email": "traceback_mail",
        "product_name": "product_name",
        "hostname": "java.hostname",
        "db-backend": "db_backend",
        "db-user": "db_user",
        "db-password": "db_password",
        "db-name": "db_name",
        "db-host": "db_host",
        "db-port": "db_port",
        "db-ssl-enabled": "db_ssl_enabled",
        "db-ca-cert": "db_ca_cert",
        "report-db-ca-cert": "report_db_sslrootcert",
        "report-db-backend": "report_db_backend",
        "report-db-name": "report_db_name",
        "report-db-host": "report_db_host",
        "report-db-port": "report_db_port",
        "report-db-user": "report_db_user",
        "report-db-password": "report_db_password",
        "report-db-ssl-enabled": "report_db_ssl_enabled",
        "enable-tftp": "enable_tftp",
    }

    config_opts = {}
    for answer_key, rhn_key in mapping.items():
        if answer_key in answers:
            config_opts[rhn_key] = answers[answer_key]

    # Add hostname itself
    config_opts["hostname"] = hostname

    # Merge session secrets
    config_opts.update(secrets)

    # Write config to main rhn.conf and prep rhn.conf
    update_config_file(DEFAULT_RHN_CONF_LOCATION, config_opts)
    update_config_file(PREP_RHN_CONF_LOCATION, config_opts)

    # Setup organization credentials if scc is requested
    scc_user = answers.get("scc-user")
    scc_pass = answers.get("scc-pass")
    if args.scc and scc_user and scc_pass:
        print("* Setting up SUSE Customer Center credentials.")
        scc_pass_enc = (
            base64.b64encode(scc_pass.encode("utf-8")).decode("utf-8").strip()
        )
        scc_url = "https://scc.suse.com"
        if os.path.exists("/etc/susemanager.conf"):
            try:
                with open("/etc/susemanager.conf", "r") as f:
                    for line in f:
                        if line.strip().startswith("scc_url"):
                            parts = line.split("=", 1)
                            if len(parts) > 1:
                                scc_url = parts[1].strip()
            except Exception:
                pass

        # Insert credentials via spacewalk-sql
        insert_query = f"""
        INSERT INTO suseCredentials (id, user_id, type, username, password, url)
        VALUES (sequence_nextval('suse_credentials_id_seq'), NULL, 'scc',
                '{scc_user}', '{scc_pass_enc}', '{scc_url}');
        """
        _, err, rc = run_sql(insert_query)
        if rc != 0:
            sys.stderr.write(f"*** Setup Organization Credentials failed: {err}\n")
            sys.exit(1)

    print("* Configuring apache SSL virtual host.")
    # Run spacewalk-setup-httpd
    no_ssl = answers.get("no-ssl", "").lower() in ("y", "yes")
    setup_httpd_args = ["/usr/bin/spacewalk-setup-httpd"]
    if no_ssl:
        setup_httpd_args.append("--no-ssl")
    subprocess.check_call(setup_httpd_args)

    print("* Update configuration in database.")
    # Verify/insert hostname in rhnTemplateString
    chk_query = "SELECT value FROM rhnTemplateString WHERE label = 'hostname';"
    out, _, rc = run_sql(chk_query)
    if not out:
        ins_query = f"""
        INSERT INTO rhnTemplateString (id, category_id, label, value, description)
        VALUES (sequence_nextval('rhn_template_str_id_seq'),
                (SELECT id FROM rhnTemplateCategory WHERE label = 'org_strings'),
                'hostname', '{hostname}', 'Host name for the Red Hat Satellite');
        """
        _, err, rc = run_sql(ins_query)
        if rc != 0:
            sys.stderr.write(f"Error inserting hostname template string: {err}\n")

    print("* Setting up Cobbler..")
    # Run spacewalk-setup-cobbler
    subprocess.check_call(
        [
            "/usr/bin/spacewalk-setup-cobbler",
            "--apache2-config-directory",
            "/etc/apache2/conf.d",
            "-f",
            hostname,
        ]
    )

    # Ensure cobbler.host = localhost is set in main rhn.conf
    update_config_file(DEFAULT_RHN_CONF_LOCATION, {"cobbler.host": "localhost"})

    # Check if cobblerd is running
    try:
        cobbler_ps = subprocess.call(["ps", "-A"], stdout=subprocess.PIPE)
        # Note: ps output checks are simplified in python
        # If cobblerd is in ps, run cobbler mkloaders and sync
        ps_out = subprocess.check_output(["ps", "-A"]).decode("utf-8", errors="ignore")
        if "cobblerd" in ps_out:
            subprocess.call(["cobbler", "mkloaders"])
            subprocess.call(["cobbler", "sync"])
    except Exception:
        pass

    try:
        subprocess.call(["systemctl", "enable", "tftp.socket"])
    except Exception:
        pass

    print("* Deploying configuration files.")
    if no_ssl:
        update_config_file(DEFAULT_RHN_CONF_LOCATION, {"server.no_ssl": "1"})

    print("* Enabling spacewalk services.")
    try:
        subprocess.check_call(
            ["/usr/sbin/spacewalk-service", "--level", "35", "enable"]
        )
    except Exception as e:
        sys.stderr.write(f"Could not turn spacewalk services on: {e}\n")
        sys.exit(11)

    print("Installation complete.")


if __name__ == "__main__":
    main()
