#!/bin/bash

exit_code=$1

if [ "$exit_code" -eq 0 ]; then
    echo "Billing service stopped cleanly or skipped. Ensuring it stays down."
    # -O (capital O) keeps the service in a down state
    s6-svc -O .
else
    echo "Billing service crashed with exit code $exit_code. Restarting..."
fi

exit 0
