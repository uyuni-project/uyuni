#: ../src/spacecmd/system.py:4886
msgid ""
"system_bootstrap: Bootstrap a system for management via either Salt or Salt "
"SSH."
msgstr "system_bootstrap: ບູດສະແຕຣັບ (Bootstrap) ລະບົບເພື່ອຈັດການຜ່ານ Salt ຫຼື Salt SSH."

#: ../src/spacecmd/system.py:4889
msgid ""
"usage: bootstrap [options]\n"
"\n"
"    options:\n"
"        -H HOSTNAME\n"
"        -p SSH_PORT\n"
"        -u SSH_USERNAME\n"
"        -P SSH_PASSWORD\n"
"        -k SSH_PRIVATEKEY_PATH\n"
"        -S SSH_PRIVATEKEY_PASSWORD\n"
"        -a ACTIVATION_KEY\n"
"        -r REACTIVATION_KEY\n"
"        --proxyid PROXY_SYSID\n"
"        --saltssh\n"
"        "
msgstr ""
"ວິທີໃຊ້: bootstrap [ຕົວເລືອກ]\n"
"\n"
"    ຕົວເລືອກ:\n"
"        -H HOSTNAME : ຊື່ໂຮສຕ໌\n"
"        -p SSH_PORT : ພອດ SSH\n"
"        -u SSH_USERNAME : ຊື່ຜູ້ໃຊ້ SSH\n"
"        -P SSH_PASSWORD : ລະຫັດຜ່ານ SSH\n"
"        -k SSH_PRIVATEKEY_PATH : ເສັ້ນທາງໄຟລ໌ Private Key\n"
"        -S SSH_PRIVATEKEY_PASSWORD : ລະຫັດຜ່ານ Private Key\n"
"        -a ACTIVATION_KEY : ຄີເປີດການໃຊ້ງານ (Activation Key)\n"
"        -r REACTIVATION_KEY : ຄີເປີດການໃຊ້ງານຄືນໃໝ່\n"
"        --proxyid PROXY_SYSID : ID ຂອງລະບົບ Proxy\n"
"        --saltssh : ຈັດການດ້ວຍ Salt SSH\n"
"        "

