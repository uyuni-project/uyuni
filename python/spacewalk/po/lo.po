"IMPORTANT MESSAGE FOLLOWS:\n"
"%s"
msgstr ""
"ຂໍ້ຄວາມສຳຄັນມີດັ່ງນີ້:\n"
"%s"

#: ../server/apacheRequest.py:160
#, python-format
msgid ""
"While running '%s': caught\n"
"%s : %s\n"
msgstr ""
"ໃນຂະນະທີ່ກຳລັງເຮັດວຽກ '%s': ພົບຂໍ້ຜິດພາດ\n"
"%s : %s\n"

