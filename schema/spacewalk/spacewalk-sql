#!/usr/bin/env python3
import sys
import os
import argparse
import subprocess

def is_true(val):
    if val is None:
        return False
    return str(val).lower() in ('1', 'y', 'true', 'yes', 'on')

def read_config(config_file):
    options = {}
    try:
        with open(config_file, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#') or '[comment]' in line:
                    continue
                if '=' in line:
                    key, val = line.split('=', 1)
                    options[key.strip()] = val.strip()
    except Exception as e:
        sys.stderr.write(f"Could not open {config_file}: {e}\n")
        sys.exit(1)
    return options

def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument('--verbose', action='store_true')
    parser.add_argument('--reportdb', action='store_true')
    parser.add_argument('--select-mode', action='store_true')
    parser.add_argument('--select-mode-direct', action='store_true')
    parser.add_argument('-i', '--interactive', action='store_true')
    
    args, unknown = parser.parse_known_args()
    
    if args.interactive and (args.select_mode or args.select_mode_direct):
        sys.stderr.write("Option --interactive cannot be used with --select-* options.\n")
        sys.exit(1)
    if args.select_mode and args.select_mode_direct:
        sys.stderr.write("Options --select-mode and --select-mode-direct are exclusive.\n")
        sys.exit(1)
        
    if args.interactive:
        if unknown:
            sys.stderr.write("In interactive mode, no input file is expected.\n")
            sys.exit(1)
    else:
        if len(unknown) != 1:
            sys.stderr.write("Usage: spacewalk-sql [-i | [ OPTIONS ] [sql-file-to-use.sql | - ]]\n")
            sys.stderr.write("    where possible OPTIONS are\n        --verbose\n        --reportdb\n        --select-mode or --select-mode-direct\n")
            sys.exit(1)
            
    config_file = "/etc/rhn/rhn.conf"
    if not os.path.exists(config_file):
        sys.stderr.write(f"The config file [{config_file}] does not seem to exist. Was Spacewalk configured yet?\n")
        sys.exit(1)
        
    options = read_config(config_file)
    
    if args.reportdb:
        for n in ('db_backend', 'db_name', 'db_user', 'db_password', 'db_host', 'db_port', 'db_ssl_enabled', 'db_sslmode', 'db_sslrootcert'):
            report_key = f'report_{n}'
            if report_key in options:
                options[n] = options[report_key]
                
    missing = []
    for n in ('db_backend', 'db_name', 'db_user', 'db_password'):
        if n not in options:
            missing.append(f"Config file [{config_file}] does not seem to have {n} set.\n")
    if missing:
        sys.stderr.write("".join(missing))
        sys.exit(1)
        
    filename = None
    if not args.interactive:
        filename = unknown[0]
        if filename != '-':
            filename = os.path.abspath(filename)
            
    if options['db_backend'] != 'postgresql':
        sys.stderr.write(f"The config file [{config_file}] specifies unknown db_backend [{options['db_backend']}] \n")
        sys.exit(1)
        
    command = ['psql', '-U', options['db_user'], '-d', options['db_name']]
    db_host = options.get('db_host')
    if db_host:
        command.extend(['-h', db_host])
        db_port = options.get('db_port')
        if db_port:
            command.extend(['-p', db_port])
            
    if not args.interactive:
        command.extend(['-v', 'ON_ERROR_STOP=ON', '-f', filename])
        
    env = os.environ.copy()
    env['PGPASSWORD'] = options['db_password']
    
    if db_host == 'localhost':
        env['PGSSLMODE'] = 'disable'
    elif is_true(options.get('db_ssl_enabled')):
        env['PGSSLMODE'] = options.get('db_sslmode', 'verify-full')
        if options.get('db_sslrootcert'):
            env['PGSSLROOTCERT'] = options['db_sslrootcert']
    else:
        env['PGSSLMODE'] = 'disable'
        
    env['PGOPTIONS'] = '--client-min-messages=error -c standard_conforming_strings=on'
    
    if args.verbose:
        sys.stderr.write(f"Running: {' '.join(command)}\n")
        
    if args.interactive or args.select_mode_direct:
        try:
            os.execvpe(command[0], command, env)
        except Exception as e:
            sys.stderr.write(f"Failed to execute psql: {e}\n")
            sys.exit(2)
            
    try:
        proc = subprocess.Popen(
            command,
            env=env,
            stdout=subprocess.PIPE,
            stderr=sys.stderr,
            stdin=sys.stdin if filename == '-' else subprocess.DEVNULL,
            text=True
        )
    except Exception as e:
        sys.stderr.write(f"Failed to start psql process: {e}\n")
        sys.exit(2)
        
    stdout_data, _ = proc.communicate()
    
    if proc.returncode != 0:
        sys.stderr.write(stdout_data)
        sys.exit(proc.returncode)
    elif args.select_mode:
        sys.stdout.write(stdout_data)
        
if __name__ == '__main__':
    main()
